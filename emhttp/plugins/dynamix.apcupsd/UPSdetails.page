$docroot = $docroot ?? $_SERVER['DOCUMENT_ROOT'] ?: '/usr/local/emhttp';
require_once "$docroot/webGui/include/Wrappers.php";
?>
<script>
function getUPSstatus() {
  var batteryLevel = "<?= _var($cfg,'BATTERYLEVEL',0) ?>";
  var batteryRuntime = "<?= _var($cfg,'MINUTES',0) ?>";

  $.post('/plugins/dynamix.apcupsd/include/UPSstatus.php',{level:batteryLevel,runtime:batteryRuntime},function(data) {
    renderUPS(data);
    setTimeout(getUPSstatus,3000);
  });
}
function renderUPS(data) {
  if (typeof data == 'string') {
    try {
      data = JSON.parse(data);
    } catch (e) {
      return;
    }
  }
  var summary = document.getElementById('ups_summary');
  var details = document.getElementById('ups_status');
  if (!summary || !details) return;
  summary.replaceChildren();
  var summaryRow = document.createElement('tr');
  summaryRow.className = 'ups';
  (data.summary || []).forEach(function(cell) {
    var summaryCell = document.createElement('td');
    summaryCell.className = cell.class || '';
    summaryCell.textContent = cell.text || '';
    summaryRow.appendChild(summaryCell);
  });
  summary.appendChild(summaryRow);

  details.replaceChildren();
  var detailRow;
  (data.details || []).forEach(function(item,index) {
    if (item.message) {
      var messageRow = document.createElement('tr');
      var messageCell = document.createElement('td');
      messageCell.colSpan = 4;
      messageCell.style.textAlign = 'center';
      messageCell.textContent = item.message;
      messageRow.appendChild(messageCell);
      details.appendChild(messageRow);
      return;
    }
    if (index % 2 == 0) {
      detailRow = document.createElement('tr');
      details.appendChild(detailRow);
    }
    var keyCell = document.createElement('td');
    var key = document.createElement('strong');
    key.textContent = item.key || '';
    keyCell.appendChild(key);
    var valueCell = document.createElement('td');
    valueCell.textContent = item.value || '';
    detailRow.appendChild(keyCell);
    detailRow.appendChild(valueCell);
  });
  if (detailRow && detailRow.children.length == 2 && (data.details || []).length % 2 == 1) {
    detailRow.appendChild(document.createElement('td'));
    detailRow.appendChild(document.createElement('td'));
  }
}
$(getUPSstatus);
</script>

<div class="TableContainer">
  <table class="tablesorter shift">
    <thead>
      <tr>
        <th style="width:15%">_(Key)_</th>
        <th style="width:35%">_(Value)_</th>
        <th style="width:15%">_(Key)_</th>
        <th style="width:35%">_(Value)_</th>
      </tr>
    </thead>
    <tbody id="ups_status">
      <tr>
        <td colspan="4"><div class="spinner"></div></td>
      </tr>
    </tbody>
  </table>
</div>
