#!/bin/bash
set -u

token="${UNRAID_PLUGIN_MANAGER_LOCK_TOKEN:-}"
scope="${UNRAID_PLUGIN_MANAGER_LOCK_SCOPE:-}"
flock_path="${1:-}"
lock_path="${2:-}"
setsid_path="${flock_path%/*}/setsid"
snapshot_dir="$scope.snapshots"
lane_dir="$scope.lane.members"
lane_lock="$scope.lane.lock"

case "$token" in
  *[!a-f0-9]*|'') exit 70 ;;
esac
[ "${#token}" -eq 32 ] || exit 70
[ "$#" -ge 4 ] || exit 70
[ "$3" = "--" ] || exit 70
[ -x "$flock_path" ] || exit 70
[ -x "$setsid_path" ] || exit 70
case "$lock_path" in
  /*) ;;
  *) exit 70 ;;
esac
[ "$scope" = "$lock_path.scope.$token" ] || exit 70

umask 077

member_is_live() {
  local lease="$1"
  local identity="${lease##*/}"
  local pid="${identity%%.*}"
  local expected_start="${identity#*.}"
  local stat=""
  local fields=""
  local current_start=""

  case "$pid:$expected_start" in
    *[!0-9:]*|:*|*:) return 1 ;;
  esac
  stat=$(cat "/proc/$pid/stat" 2>/dev/null) || return 1
  fields="${stat##*) }"
  # After removing pid/comm, starttime (field 22) is word 20.
  # shellcheck disable=SC2086
  set -- $fields
  [ "$#" -ge 20 ] || return 1
  case "$1" in
    Z|X|x) return 1 ;;
  esac
  shift 19
  current_start="$1"
  [ "$current_start" = "$expected_start" ]
}

member_is_process_group_leader() {
  local lease="$1"
  local identity="${lease##*/}"
  local pid="${identity%%.*}"
  local stat=""
  local fields=""
  local process_group=""
  local -a stat_fields=()

  member_is_live "$lease" || return 1
  [ "$pid" -gt 1 ] || return 1
  stat=$(cat "/proc/$pid/stat" 2>/dev/null) || return 1
  fields="${stat##*) }"
  read -r -a stat_fields <<< "$fields"
  [ "${#stat_fields[@]}" -ge 20 ] || return 1
  # After removing pid/comm, pgrp (field 5) is array index 2.
  process_group="${stat_fields[2]}"
  [ "$process_group" = "$pid" ]
}

release_scope_after_members_exit() {
  local empty_scans=0
  local live=0
  local lease=""

  while [ "$empty_scans" -lt 2 ]; do
    live=0
    shopt -s nullglob
    for lease in "$scope"/*; do
      if [ -f "$lease" ] && [ ! -L "$lease" ] && member_is_live "$lease"; then
        live=1
      else
        rm -rf -- "$lease"
      fi
    done
    shopt -u nullglob

    if [ "$live" -eq 1 ]; then
      empty_scans=0
    else
      empty_scans=$((empty_scans + 1))
    fi
    if [ "$empty_scans" -ge 2 ]; then
      # rmdir is the atomic empty check. A nested invocation may register after
      # our scan; in that case rmdir observes the lease and we resume waiting.
      if rmdir -- "$scope" 2>/dev/null; then
        # Retiring the scope first prevents late registration from racing
        # cleanup of the token-derived sibling paths.
        rm -rf -- "$snapshot_dir" "$lane_dir"
        rm -f -- "$lane_lock"
        return 0
      fi
      empty_scans=0
    fi
    sleep 0.05
  done
}

terminate_scope_members() {
  local lease=""
  local identity=""
  local pid=""
  local signal=""

  # Unexpected guardian death invalidates the whole mutation tree. Terminate
  # registered members which escaped its process group so none can deadlock by
  # trying to reacquire the global mutex while the coordinator waits for its
  # lease. Revalidate PID/start-time identity immediately before every signal.
  for signal in TERM KILL; do
    shopt -s nullglob
    for lease in "$scope"/*; do
      if [ -f "$lease" ] && [ ! -L "$lease" ] && member_is_live "$lease"; then
        identity="${lease##*/}"
        pid="${identity%%.*}"
        if member_is_live "$lease"; then
          kill -s "$signal" "$pid" 2>/dev/null || true
        fi
      fi
    done
    shopt -u nullglob
    [ "$signal" = "KILL" ] || sleep 0.1
  done
}

terminate_marked_operation_group() {
  local identity=""
  local pid=""

  identity=$(cat "$snapshot_dir/.operation-identity" 2>/dev/null || true)
  pid="${identity%%.*}"
  if member_is_process_group_leader "$snapshot_dir/$identity"; then
    # Revalidate identity and group leadership immediately before signalling;
    # never target a stale/reused PID or a supervisor's process group.
    if member_is_process_group_leader "$snapshot_dir/$identity"; then
      kill -KILL -- "-$pid" 2>/dev/null || true
      while member_is_live "$snapshot_dir/$identity"; do
        sleep 0.01
      done
      return 0
    fi
  fi

  return 1
}

shift 3
[ "$#" -gt 0 ] || exit 70

# Entered beneath setsid by the guardian. Publish the operation's identity only
# after it is the leader of its final private process group, then exec mutation
# code without any lock descriptor or internal supervisor mode.
if [ "${UNRAID_PLUGIN_MANAGER_LOCK_OPERATION_BOOTSTRAP:-0}" = "1" ]; then
  bootstrap_pid="$BASHPID"
  stat=$(cat "/proc/$bootstrap_pid/stat" 2>/dev/null) || exit 70
  fields="${stat##*) }"
  read -r -a stat_fields <<< "$fields"
  [ "${#stat_fields[@]}" -ge 20 ] || exit 70
  start_time="${stat_fields[19]}"
  process_group="${stat_fields[2]}"
  case "$bootstrap_pid:$start_time:$process_group" in
    *[!0-9:]*|:*|*:) exit 70 ;;
  esac
  [ "$bootstrap_pid" -gt 1 ] || exit 70
  [ "$process_group" = "$bootstrap_pid" ] || exit 70
  child_ready_path="$snapshot_dir/.operation-identity"
  printf '%s.%s\n' "$bootstrap_pid" "$start_time" > "$child_ready_path" || exit 70
  chmod 0400 "$child_ready_path" || exit 70
  trap - INT QUIT TERM HUP
  export UNRAID_PLUGIN_MANAGER_LOCK_GUARDIAN=''
  export UNRAID_PLUGIN_MANAGER_LOCK_FD=''
  export UNRAID_PLUGIN_MANAGER_LOCK_OPERATION_BOOTSTRAP=''
  export UNRAID_PLUGIN_MANAGER_LOCK_ENTRY="$token"
  exec "$@"
fi

# The guardian inherits the already-locked descriptor and re-execs once so
# procfs exposes its owner identity. If the coordinating supervisor is killed,
# this process keeps flock until the mutation and every registered descendant
# have exited.
if [ "${UNRAID_PLUGIN_MANAGER_LOCK_GUARDIAN:-0}" = "1" ]; then
  lock_fd="${UNRAID_PLUGIN_MANAGER_LOCK_FD:-}"
  case "$lock_fd" in
    *[!0-9]*|'') exit 70 ;;
  esac
  if [ "${UNRAID_PLUGIN_MANAGER_LOCK_OWNER_PID:-}" != "$$" ] ||
    [ "${UNRAID_PLUGIN_MANAGER_LOCK_PROTOCOL:-}" != "2" ]; then
    export UNRAID_PLUGIN_MANAGER_LOCK_OWNER_PID="$$"
    export UNRAID_PLUGIN_MANAGER_LOCK_PROTOCOL=2
    exec "$0" "$flock_path" "$lock_path" -- "$@"
  fi
  [ "${UNRAID_PLUGIN_MANAGER_LOCK_PROTOCOL:-}" = "2" ] || exit 70
  [ -f "$lock_path" ] || exit 70
  [ ! -L "$lock_path" ] || exit 70
  [ "/proc/$$/fd/$lock_fd" -ef "$lock_path" ] || exit 70

  child_pid=""
  launcher_pid=""
  child_ready=0
  child_ready_path="$snapshot_dir/.operation-identity"
  pending_signal=""

  # Invoked indirectly by the signal traps below.
  # shellcheck disable=SC2329
  record_child_signal() {
    if [ "$child_ready" -eq 1 ] && [ -n "$child_pid" ]; then
      kill -s "$1" -- "-$child_pid" 2>/dev/null ||
        kill -s "$1" "$child_pid" 2>/dev/null ||
        true
    else
      pending_signal="$1"
    fi
  }

  trap 'record_child_signal TERM' TERM
  trap 'record_child_signal INT' INT
  trap 'record_child_signal HUP' HUP

  # The operation gets its own process group and never receives the mutex
  # descriptor. Its bootstrap publishes that group only after resetting signal
  # dispositions, closing the pending-signal race. The one-use entry token
  # distinguishes the direct operation from nested plugin invocations.
  set +m
  (
    # Bash otherwise starts an asynchronous command with INT/QUIT ignored.
    # Reset dispositions in the forked shell before it becomes the operation.
    trap - INT QUIT TERM HUP
    export UNRAID_PLUGIN_MANAGER_LOCK_OPERATION_BOOTSTRAP=1
    exec {lock_fd}>&-
    exec "$setsid_path" -w \
      "$0" "$flock_path" "$lock_path" -- "$@"
  ) &
  launcher_pid=$!
  operation_identity=""
  while kill -0 "$launcher_pid" 2>/dev/null; do
    operation_identity=$(cat "$child_ready_path" 2>/dev/null || true)
    if [ "${operation_identity%%.*}" = "$launcher_pid" ] &&
      member_is_process_group_leader "$snapshot_dir/$operation_identity"; then
      child_pid="${operation_identity%%.*}"
      child_ready=1
      break
    fi
    sleep 0.01
  done
  if [ -n "$pending_signal" ]; then
    signal="$pending_signal"
    pending_signal=""
    kill -s "$signal" -- "-$child_pid" 2>/dev/null ||
      kill -s "$signal" "$child_pid" 2>/dev/null ||
      true
  fi

  while true; do
    wait "$launcher_pid"
    status=$?
    if ! kill -0 "$launcher_pid" 2>/dev/null; then
      break
    fi
  done
  launcher_pid=""
  child_pid=""
  release_scope_after_members_exit
  exec {lock_fd}>&-
  exit "$status"
fi

# The coordinator validates and acquires the mutex, then gives a guardian a
# second reference to the same flock-owned open file description. Mutation
# code receives neither reference.
exec {lock_fd}<>"$lock_path" || exit 70
if [ ! -f "$lock_path" ] ||
  [ -L "$lock_path" ] ||
  [ ! "/proc/$$/fd/$lock_fd" -ef "$lock_path" ]; then
  exec {lock_fd}>&-
  exit 70
fi
"$flock_path" "$lock_fd" || {
  exec {lock_fd}>&-
  exit 70
}

mkdir -- "$scope" || exit 70
chmod 0700 "$scope" || exit 70
mkdir -- "$snapshot_dir" || exit 70
chmod 0700 "$snapshot_dir" || exit 70
mkdir -- "$lane_dir" || exit 70
chmod 0700 "$lane_dir" || exit 70
: > "$lane_lock" || exit 70
chmod 0600 "$lane_lock" || exit 70

guardian_pid=""
pending_signal=""

# Invoked indirectly by the signal traps below.
# shellcheck disable=SC2329
forward_guardian_signal() {
  if [ -n "$guardian_pid" ]; then
    kill -s "$1" "$guardian_pid" 2>/dev/null || true
  else
    pending_signal="$1"
  fi
}

trap 'forward_guardian_signal TERM' TERM
trap 'forward_guardian_signal INT' INT
trap 'forward_guardian_signal HUP' HUP

# A private guardian process group keeps a coordinator-only SIGKILL from
# reaching either lock guardian or mutation. Ordinary signals are forwarded
# through the two supervisors and preserve the mutation's final status.
set -m
UNRAID_PLUGIN_MANAGER_LOCK_GUARDIAN=1 \
UNRAID_PLUGIN_MANAGER_LOCK_FD="$lock_fd" \
  "$0" "$flock_path" "$lock_path" -- "$@" &
guardian_pid=$!
set +m
if [ -n "$pending_signal" ]; then
  signal="$pending_signal"
  pending_signal=""
  kill -s "$signal" "$guardian_pid" 2>/dev/null || true
fi

while true; do
  wait "$guardian_pid"
  status=$?
  if ! kill -0 "$guardian_pid" 2>/dev/null; then
    break
  fi
done
guardian_pid=""

# A normally exiting guardian retires the scope itself. If it died
# unexpectedly, terminate its mutation group before this last flock reference
# is closed, then perform the same lease-aware retirement locally.
if [ -d "$scope" ]; then
  terminate_marked_operation_group || true
  terminate_scope_members
  release_scope_after_members_exit
fi
exec {lock_fd}>&-
exit "$status"
