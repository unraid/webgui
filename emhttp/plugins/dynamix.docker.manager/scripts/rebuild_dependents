<?
// usage: rebuild_dependents <container> ...
// Rebuild the containers that use the network of <container> after it was recreated.
// Waits up to 5 minutes for <container> to start, e.g. Auto Update starts it after the update.
$docroot ??= ($_SERVER['DOCUMENT_ROOT'] ?: '/usr/local/emhttp');
require_once "$docroot/plugins/dynamix.docker.manager/include/DockerClient.php";

$names = array_slice($argv,1);
foreach ($names as $name) {
  for ($n = 0; $n < 60 && DockerUtil::ctMap(escapeshellarg($name),'State.Running') == 'false'; $n++) sleep(5);
}
foreach (rebuildNetworkDependents($names,true) as $msg) echo "$msg\n";
?>
