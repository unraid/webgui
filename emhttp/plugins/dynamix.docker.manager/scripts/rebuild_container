<?
$docroot ??= ($_SERVER['DOCUMENT_ROOT'] ?: '/usr/local/emhttp');
require_once "$docroot/plugins/dynamix.docker.manager/include/DockerClient.php";

$DockerClient = new DockerClient();
$DockerUpdate = new DockerUpdate();
$DockerTemplates = new DockerTemplates();

$start  = array_map(function($row){return strtok($row,' ');},@file('/var/lib/docker/unraid-autostart',FILE_IGNORE_NEW_LINES|FILE_SKIP_EMPTY_LINES) ?: []);
$custom = DockerUtil::custom();
$subnet = DockerUtil::network($custom);
$cpus   = DockerUtil::cpus();
$tmpl   = $DockerTemplates->getUserTemplate($argv[1]);
$xml    = file_get_contents($tmpl);

[$cmd,$name,$repository] = xmlToCommand($tmpl);
$old = $DockerClient->getImageID($repository);

// Pass the image command to the Tailscale and NetBird hooks as CreateDocker.php does, falling back to the old container
if (str_contains($cmd, "--entrypoint='/opt/unraid/")) {
  $image = $DockerClient->getDockerJSON('/images/' . $repository . '/json')['Config'] ?? [];
  $env = [];
  foreach (['ENTRYPOINT' => 'Entrypoint', 'CMD' => 'Cmd'] as $var => $key) if (isset($image[$key])) $env[] = "ORG_$var=" . implode(' ', array_map('escapeshellarg', $image[$key]));
  if (!$image) $env = preg_grep('/^ORG_(ENTRYPOINT|CMD)=/', $DockerClient->getContainerDetails($name)['Config']['Env'] ?? []);
  if ($env) $cmd = str_replace('-l net.unraid.docker.managed=dockerman', '-e ' . implode(' -e ', array_map('escapeshellarg', $env)) . ' -l net.unraid.docker.managed=dockerman', $cmd);
}

removeContainer($name,false,false);
execCommand(str_replace('/docker create ','/docker run -d ',$cmd),false);
if (!in_array($name,$start)) stopContainer($name,false,false);
$DockerClient->flushCaches();
$new = $DockerClient->getImageID($repository);
if ($old && $old != $new) removeImage($old,false);
?>
